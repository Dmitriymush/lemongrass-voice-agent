flowchart TD
    KB["kb/kb-fact-sheet.md<br/>недоторканий оригінал"] --> B["build.mjs"]
    RT["kb/routing.json<br/>правила поділу"] --> B
    P["prompt/system-prompt.md"] --> B
    C["assistant.config.json"] --> B

    B --> SPLIT{"поділ за routing.json"}
    SPLIT -->|"HOT + алергенна матриця"| INL["у системний промпт"]
    SPLIT -->|"COLD"| COLDF["kb-cold.md"]

    INL --> TOK{"K_hot > порога?"}
    TOK -->|"так"| WARN["CI падає:<br/>ревізувати поділ"]
    TOK -->|"ні"| R["build/assistant.rendered.json"]
    COLDF --> R

    R --> BR{"Гілка"}
    BR -->|"PR"| PR1["lint + тести<br/>0 кредитів"]
    PR1 -->|"fail"| BLOCK["Мердж заблоковано"]
    PR1 -->|"pass"| REV["Ревʼю"]

    BR -->|"main"| M1["eval.mjs<br/>2 сценарії + холодний кейс"]
    M1 --> D1["POST /file<br/>лише при зміні хешу"]
    D1 --> D2["PATCH /tool<br/>query + fileIds"]
    D2 --> D3["PATCH /assistant"]
    D3 --> ST["коміт state/resources.json"]
    ST --> VAPI["Vapi sandbox"]

    style BLOCK fill:#9d0208,color:#fff
    style VAPI fill:#2d6a4f,color:#fff
