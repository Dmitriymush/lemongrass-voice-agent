# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#   npm run env:check     # confirms both are set, without printing them

# Private key, not the public one. Vapi dashboard -> Settings -> API Keys.
#
# Both keys are 36-character UUIDs, so nothing about the shape tells them apart.
# The public key cannot write, and the only signal is a 401 saying you may have
# swapped them. Deploy needs PATCH /assistant, POST /file and GET /file, so it
# needs the private one.
VAPI_API_KEY=

# The assistant this repository owns. Create it once in the dashboard — an empty
# one is fine, every field is overwritten on the first deploy — and paste its id
# here. Deploy patches this id and never creates an assistant: the sandbox org is
# shared, and a stray POST would leave a duplicate for someone else to clean up.
VAPI_ASSISTANT_ID=

# In CI these two come from repository secrets under the same names, so there is
# no .env in the pipeline. The scripts load the file only if it exists.
