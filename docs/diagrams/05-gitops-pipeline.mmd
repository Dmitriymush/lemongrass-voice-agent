flowchart TD
    KB["kb/kb-fact-sheet.md<br/>untouched original"] --> B["build.mjs"]
    RT["kb/routing.json<br/>split rules"] --> B
    P["prompt/system-prompt.md"] --> B
    C["assistant.config.json"] --> B

    B --> SPLIT{"split by routing.json"}
    SPLIT -->|"hot + allergen matrix"| INL["into the system prompt"]
    SPLIT -->|"cold"| COLDF["kb/generated/kb-cold.txt"]

    INL --> TOK{"hot core over cap?"}
    TOK -->|"yes"| WARN["build fails:<br/>revisit the split"]
    TOK -->|"no"| R["build/assistant.rendered.json"]
    COLDF --> R

    R --> BR{"Branch"}
    BR -->|"pull request"| PR1["suite + build<br/>zero credits"]
    PR1 -->|"fail"| BLOCK["merge blocked"]
    PR1 -->|"pass"| REV["review"]

    BR -->|"main"| M1["eval.mjs<br/>reviewer scenarios + cold case"]
    M1 --> D1["POST /file<br/>only if the hash changed"]
    D1 --> D2["poll until processed"]
    D2 --> D3["PATCH /assistant<br/>with the file id injected"]
    D3 --> D4["read back, re-check contract"]
    D4 --> ST["commit state/resources.json"]
    ST --> VAPI["Vapi sandbox"]

    style BLOCK fill:#9d0208,color:#fff
    style VAPI fill:#2d6a4f,color:#fff
