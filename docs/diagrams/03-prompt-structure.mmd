        direction TB
        S1["1. Identity and style"]
        S2["2. hot_knowledge<br/>contacts, hours, parking, policies"]
        S3["3. allergen_matrix<br/>verbatim 'Contains' lines"]
        S4["4. scope<br/>covered topics + anti-examples"]
        S5["5. Grounding rules"]
        S6["6. When to call the query tool"]
        S7["7. Escalation to a person"]
        S8["8. Allergen policy"]
        S9["9. Reservation flow"]
        S10["10. Banned phrases"]
        S11["11. Role lock"]
        S12["12. Call closure"]
        S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8 --> S9 --> S10 --> S11 --> S12
